# MEDUSA game (Solana) - server-side environment variables, set in
# Vercel -> Project -> Settings -> Environment Variables. None of these ever reach
# the browser; only the /api/*.js serverless functions read them.
# Never commit a real .env with values.

# Supabase project URL and SERVICE_ROLE key (Dashboard -> Settings -> API).
# The service role bypasses Row Level Security: server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GMGN OpenAPI key: grades a wallet's Solana trading history (read-only).
GMGN_API_KEY=

# Password for /admin.html, where memecoin mints are added to the round pool.
ADMIN_PASSWORD=
